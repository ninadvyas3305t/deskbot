# DeskBot Environment Configuration
# Copy this file to .env to configure secrets:
#   cp .env.example .env

# -------------------------------------------------------------
# 1. Cloud AI Reasoning (NVIDIA NIM)
# Get a free API key at: https://build.nvidia.com
# -------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-key-here

# -------------------------------------------------------------
# 2. Hardware Serial Port (Optional - auto-detected if omitted)
# macOS: /dev/cu.usbmodem*
# Windows: COM4
# -------------------------------------------------------------
# DESKBOT_PORT=/dev/cu.usbmodem5C930751681
# DESKBOT_BAUD=921600

# -------------------------------------------------------------
# 3. Audio & Voice Settings (Optional)
# -------------------------------------------------------------
# DESKBOT_WAKE_MODEL=hey_jarvis
# DESKBOT_WAKE_THRESHOLD=0.50
# DESKBOT_MIC_GAIN=1.2
# DESKBOT_STT_MODEL=base
# DESKBOT_TTS_ENABLED=1
# DESKBOT_DEBUG=0
